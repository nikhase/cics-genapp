          },
          "expectedResult": {
            "CA-RETURN-CODE": "00",
            "message": "Motor Policy Deleted",
            "dbCheck": "noRecord"
          }
        },
        {
          "testId": "MP-I-001",
          "operation": "inquire",
          "description": "Erfolgreiche Abfrage einer bestehenden Police",
          "input": {
            "CA-REQUEST-ID": "IMOTOR",
