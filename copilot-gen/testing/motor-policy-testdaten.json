            "CA-M-MODEL": "Golf",
            "CA-M-VALUE": 250000,
            "CA-M-REGNUMBER": "K-AB-123",
            "CA-M-COLOUR": "Rot",
            "CA-M-CC": 1998,
            "CA-M-MANUFACTURED": "2022-01-15",
            "CA-M-PREMIUM": 120000,
            "CA-M-ACCIDENTS": 0
          }
