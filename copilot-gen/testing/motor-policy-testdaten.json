{
  "testSets": {
    "standard": {
      "description": "Standardtestdaten für reguläre Tests",
      "testCases": [
        {
          "testId": "MP-A-001",
          "operation": "add",
          "description": "Erfolgreiche Erstellung einer neuen Kfz-Versicherung",
          "input": {
            "CA-REQUEST-ID": "AMOTOR",
            "CA-CUSTOMER-NUM": 1234567890,
            "CA-POLICY-NUM": 0,
            "CA-ISSUE-DATE": "2023-01-01",
            "CA-EXPIRY-DATE": "2024-01-01",
            "CA-BROKERID": 1234567890,
            "CA-BROKERSREF": "BRREF12345",
            "CA-PAYMENT": 120000,
            "CA-M-MAKE": "Volkswagen",
            "CA-M-MODEL": "Golf",
            "CA-M-VALUE": 250000,
            "CA-M-REGNUMBER": "K-AB-123",
            "CA-M-COLOUR": "Rot",
            "CA-M-CC": 1998,
            "CA-M-MANUFACTURED": "2022-01-15",
            "CA-M-PREMIUM": 120000,
            "CA-M-ACCIDENTS": 0
          },
          "expectedResult": {
            "CA-RETURN-CODE": "00",
            "message": "New Motor Policy Inserted",
            "dbCheck": "recordExists"
          }
        },
        {
          "testId": "MP-A-002",
          "operation": "add",
          "description": "Fehler beim Hinzufügen einer Police wegen fehlender Pflichtfelder",
          "input": {
            "CA-REQUEST-ID": "AMOTOR",
            "CA-CUSTOMER-NUM": 1234567890,
            "CA-POLICY-NUM": 0,
            "CA-ISSUE-DATE": "2023-01-01",
            "CA-EXPIRY-DATE": "2024-01-01",
            "CA-BROKERID": 1234567890,
            "CA-BROKERSREF": "BRREF12345",
            "CA-PAYMENT": 120000,
            "CA-M-MAKE": "Volkswagen",
            "CA-M-MODEL": "Golf",
            "CA-M-VALUE": 250000,
            "CA-M-REGNUMBER": "",
            "CA-M-COLOUR": "Rot",
            "CA-M-CC": 1998,
            "CA-M-MANUFACTURED": "2022-01-15",
            "CA-M-PREMIUM": 120000,
            "CA-M-ACCIDENTS": 0
          },
          "expectedResult": {
            "CA-RETURN-CODE": "01",
            "message": "Error Adding Motor Policy",
            "dbCheck": "noRecord"
          }
        },
        {
          "testId": "MP-U-001",
          "operation": "update",
          "description": "Erfolgreiche Aktualisierung einer bestehenden Police",
          "input": {
            "CA-REQUEST-ID": "UMOTOR",
            "CA-CUSTOMER-NUM": 1234567890,
            "CA-POLICY-NUM": 1000000001,
            "CA-M-VALUE": 280000,
            "CA-M-COLOUR": "Blau",
            "CA-M-PREMIUM": 135000
          },
          "expectedResult": {
            "CA-RETURN-CODE": "00",
            "message": "Motor Policy Updated",
            "dbCheck": {
              "DB2-M-VALUE": 280000,
              "DB2-M-COLOUR": "Blau",
              "DB2-M-PREMIUM": 135000
            }
          }
        },
        {
          "testId": "MP-D-001",
          "operation": "delete",
          "description": "Erfolgreiches Löschen einer bestehenden Police",
          "input": {
            "CA-REQUEST-ID": "DMOTOR",
            "CA-CUSTOMER-NUM": 1234567890,
