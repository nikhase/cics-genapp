# Environment Variables Template
# Copy this file to .env.dev or .env.prod and fill in the actual values

# API Configuration
# Base URL for all REST API calls to the backend
VITE_API_BASE_URL=http://localhost:8080

# Zitadel OIDC Configuration
# Client ID registered in Zitadel for this frontend application
VITE_ZITADEL_CLIENT_ID=your-client-id

# Zitadel Authority/Realm URL
VITE_ZITADEL_AUTHORITY=http://localhost:8080/auth

# Logging Level
# Options: debug, info, warn, error
VITE_LOG_LEVEL=debug
